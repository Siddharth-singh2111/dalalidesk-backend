# Copy to .env and adjust. Local Docker: see docker-compose.yml (password localdev).

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=localdev
DB_PORT=5433
DB_HOST=127.0.0.1

QUERY_REMOTE=false

# Used only when QUERY_REMOTE=true — Flask app URL (not the database port).
REMOTE_IP=127.0.0.1
REMOTE_PORT=5000

ACCESS_KEY=ACCESS_KEY

# Supabase (when remote DB is back): set DB_HOST=db.<project-ref>.supabase.co and DB_PASSWORD from dashboard.
